{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -I -c \"import runpy,subprocess,sys;r=subprocess.run(['git','rev-parse','--show-toplevel'],capture_output=True,text=True).stdout.strip();p=r+'/templates/ci/agent_hooks.py';sys.argv=[p,*sys.argv[1:]];runpy.run_path(p,run_name='__main__')\" pre-bash",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I -c \"import runpy,subprocess,sys;r=subprocess.run(['git','rev-parse','--show-toplevel'],capture_output=True,text=True).stdout.strip();p=r+'/templates/ci/agent_hooks.py';sys.argv=[p,*sys.argv[1:]];runpy.run_path(p,run_name='__main__')\" stop templates/ci/repo_checks.py --docs-exclude templates",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
